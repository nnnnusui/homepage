{
  "editor.tabSize": 2,
  "editor.indentSize": 2,
  "eslint.format.enable": true,
  "stylelint.validate": ["css", "stylus"],
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.fixAll.stylelint": "explicit",
  },
  "js/ts.tsdk.path": "./node_modules/typescript/lib",
  "task.allowAutomaticTasks": "on",
  "files.exclude": {
    "**/.DS_Store": true,
  },
  "files.readonlyInclude": {
    "node_modules/**/*": true,
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "*": "$(capture).d.ts, $(capture).d.ts.map",
    "*.ts": "$(capture).spec.ts",
    "*.tsx": "$(capture).module.css, $(capture).spec.tsx, $(capture).stories.tsx",
    "package.json": "pnpm-lock.yaml, pnpm-workspace.yaml",
    "tsconfig.json": "tsconfig.*.json, *.config.ts, .stylelintrc.yml, vitest.shims.d.ts",
  },
  "workbench.editor.labelFormat": "default",
  "workbench.editor.customLabels.patterns": {
    "**/index.tsx": "${dirname}/.tsx",
  },
  "plopTemplates.configFileName": "script/plopfile.ts",
  "plopTemplates.plopCommand": "plopTemplates",
  "storybook-opener.openInEditor.enable": true,
}
